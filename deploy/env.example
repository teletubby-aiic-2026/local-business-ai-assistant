# ic26 서버 환경 파일 틀  →  서버의 /etc/ic26/env (소유자 root, 권한 600)
#
# install_was.sh 가 /etc/ic26/env 가 없을 때만 이 파일을 복사해 만듭니다. 이미 있으면 건드리지 않습니다.
# 값은 서버에서 편집기로 직접 입력합니다:   sudo vi -n -i NONE /etc/ic26/env
#   - 명령줄 인자(echo, sed, export 등), 셸 히스토리, 메신저, 캡처에 값을 남기지 않습니다.
#   - 이 파일은 저장소에 올라가는 틀입니다. 실제 값을 적어서 저장소에 올리지 않습니다.
#
# 적는 규칙 (systemd 가 읽습니다)
#   - 한 줄에 NAME=값 하나. 값에 따옴표와 앞뒤 공백을 넣지 않습니다.
#   - 주석(#)은 줄 맨 앞에서만 씁니다. 값 뒤에 주석을 붙이면 주석까지 값이 됩니다.
#   - 값을 바꾼 뒤에는 서비스를 다시 시작합니다:   sudo systemctl restart ic26-review ic26-marketing ic26-was

# ── 실행 모드 ──
# live: HCX-005 실시간 호출(키 필요, 호출마다 비용). mock: 키 없이 도는 시험용 실행(저장된 예시, 실제 AI 결과 아님)
# 맞춤 마케팅(ic26-marketing)도 이 값을 따릅니다. 마케팅만 다르게 하려면 아래 '맞춤 마케팅' 칸의 MARKETING_APP_MODE
APP_MODE=live

# ── 비밀 값을 Secret Manager 에서 받기 (권장, deploy/README.md 5-1절) ──
# Secret Manager 의 비밀 ID 를 넣으면, 서버가 켜질 때 ic26-secrets 서비스가 값을 받아 /run/ic26/secrets.env(메모리)에 두고
# 서비스 4개가 이 파일의 값을 씁니다. 그때 이 파일의 비밀 값 줄(키·DB 비밀번호 등)은 이름만 두고 값을 비웁니다.
# 비밀은 env 이름을 키로 한 JSON 으로 만듭니다: {"CLOVA_API_KEY": "...", "CLOVASTUDIO_API_KEY": "...", ..., "DB_PASSWORD": "..."}
# 이 서버에 Server Role(정책 NCP_SECRETMANAGER_USER)이 붙어 있어야 합니다. 비워 두면 아래 줄의 값을 그대로 씁니다.
# (이름에 KEY·SECRET 을 넣지 않은 것은 이미지 정리 스크립트 prepare_image.sh 가 이 줄을 비우지 않게 하기 위해서입니다)
IC26_SM_ID=

# ── HCX(CLOVA Studio) 키 ──
# Secret Manager 를 쓰면 아래 세 줄은 이름만 두고 비웁니다.
# 같은 서버 전용 키를 아래 세 줄에 똑같이 넣습니다. 코드마다 읽는 이름이 달라서 세 줄이 모두 필요합니다.
# 키 값만 넣고 앞에 'Bearer ' 를 붙이지 않습니다. 개발용 키를 쓰지 않습니다.
# 비서 화면 서버(ic26-was)와 맞춤 마케팅(ic26-marketing)이 읽는 이름
CLOVA_API_KEY=
# 리뷰 분석(ic26-review)이 읽는 이름
CLOVASTUDIO_API_KEY=
# 상권 챗봇(ic26-market)이 읽는 이름. 가운데 밑줄이 하나 더 있습니다 (CLOVA_STUDIO)
CLOVA_STUDIO_API_KEY=

# ── (선택) 리뷰 분류 모델 ──
# 리뷰 분류만 다른 모델로 돌릴 때 아래 줄 맨 앞의 '# ' 를 지웁니다. 이 줄이 없으면 HCX-005 입니다. 바꾸면 분류 품질을 다시 잽니다.
# LLM_MODEL_REVIEW=HCX-DASH-002

# ── 상권 챗봇 (ic26-market 이 켜져 있을 때만 쓰임) ──
# 1 이면 챗봇을 켭니다. 비우거나 0 이면 챗봇이 없습니다.
ASSISTANT_ENABLED=1
# 하루에 HCX 를 부를 수 있는 최대 횟수 (서버 한 대 기준)
ASSISTANT_MODEL_DAILY_LIMIT=2000
# AI 계획기를 끕니다 (질문 분류는 규칙으로, 답 문장만 HCX 가 씀). 계획기가 질문에 없는 기간("2022년 2분기")을 지어내 "자료가 없어요"로
# 답하는 일이 11/14 실시간 시험에서 나왔고(자연스러운 질문 8개 중 3개: 유동인구·연령대·'언제' 질문에서 되풀이), 끄면 16번 중 16번 정확했습니다.
# 상권 파트가 계획기를 고치면 이 줄을 지웁니다.
ASSISTANT_PLANNER=off

# ── (선택) 상권 서비스의 다른 키 (ic26-market 이 읽음). 비워 둬도 서랍의 상권 채팅은 돕니다 ──
# 상권 공식 자료는 서버에서 새로 모으지 않고, 팀이 확인한 자료 묶음을 install_market_data.sh 로 깝니다.
# 서울 열린데이터광장 OpenAPI 키 (선택).
#   비워 두면 예시·샘플로 안전하게 돕니다: 상권 분석 화면(#/market)의 '서울시 최신 데이터 확인'은 서울시 공개 샘플 키로
#     자료마다 1~5건만 보고 기록은 남기지 않으며, '우리 동네 문화행사'는 예시 2건을 보여 줍니다. 서버에 깐 공식 자료로 하는 분석은 그대로입니다.
#   넣으면(Secret Manager 의 같은 이름, 또는 이 줄에 값): 최신 분기 발행 여부를 실제 키로 확인해 기록하고, 문화행사를 실제 자료로 보여 줍니다.
#     자료를 새로 모을 때(scripts.prepare_data --collect)도 이 키를 씁니다. 새 분기를 자동으로 싣지는 않습니다(안내만).
SEOUL_OPENAPI_KEY=
# NAVER Maps(NCP) 식별자·비밀키: 상권 서비스 자체 화면의 지도·주소 검색에만 씁니다. 그 화면은 밖에 열지 않으므로 비워 둬도 됩니다.
# 넣을 때는 NCP 콘솔의 Maps 애플리케이션에 실제 접속 주소를 등록합니다. 비밀키는 서버에만 둡니다.
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# APP_PUBLIC_ORIGIN 은 적지 않습니다 (적으면 비서 화면 서버의 요청을 상권 서비스가 거절합니다).

# ── (선택) 로그인 (5차 회의 11/18) ──
# 로그인 대화상자의 '시연 사장님으로 바로 시작'(가게 세 곳: 온기한식·바삭치킨·몽글카페). 기본 켜짐. 막으려면 0.
# 계정·세션(users·user_stores·auth_sessions 표)은 DB_HOST 가 있으면 DB 에 두고, 없으면 서버 메모리에 둡니다(다시 켜면 사라짐).
# DEMO_ACCOUNT_ENABLED=1

# ── (선택) 비서 화면 서버가 상권 서비스를 부르는 길 (서랍의 상권 채팅) ──
# 기본값이 맞으면 아무것도 적지 않습니다. 서랍을 이 서버에서 끄려면 MARKET_URL=off.
# MARKET_URL=http://127.0.0.1:8766
# 질문 하나를 기다리는 최대 시간(초). 기본 75 (로드 밸런서 유휴 시간 120초보다 짧게)
# MARKET_TIMEOUT_SEC=75

# ── (선택) 비서 화면 서버가 리뷰 분석 서비스의 고객응대 API 를 부르는 길 (캡처 입력·응대 점수·종합 리포트) ──
# 기본값이 맞으면 아무것도 적지 않습니다 (REVIEW_INSIGHT_URL 과 같은 곳). 이 서버에서 끄려면 CARE_URL=off.
# CARE_URL=http://127.0.0.1:8020
# 캡처 하나를 기다리는 최대 시간(초). 기본 100 (긴 캡처는 조각마다 HCX 를 부름. 로드 밸런서 유휴 시간 120초보다 짧게)
# CARE_TIMEOUT_SEC=100
# 손님용 문의 페이지(/s/…)와 /api/care/public/* 를 엽니다. 보안 검토 전까지 켜지 않습니다 (기본 꺼짐)
# CARE_PUBLIC=1
# 리뷰 저장(붙여넣기·캡처 후보 저장)을 기다리는 최대 시간(초). 기본 45. 리뷰 분석이 저장하며 HCX 로 분류해서 10초로는 모자람
# REVIEW_PASTE_TIMEOUT_SEC=45

# ── (선택) 맞춤 마케팅 (ic26-marketing, 127.0.0.1:8030) ──
# 비서 화면 서버가 /api/marketing-survey/* 를 이 서버로 대신 불러 줍니다. 기본값이 맞으면 아무것도 적지 않습니다.
# 모드: 적지 않으면 APP_MODE 를 따릅니다. mock 이면 키가 있어도 HCX 를 부르지 않습니다.
# MARKETING_APP_MODE=mock
# 이 서버에서 맞춤 마케팅을 끄려면 아래 줄을 넣고(화면 서버가 부르지 않음), 서비스도 끕니다: sudo systemctl disable --now ic26-marketing
# MARKETING_SURVEY_URL=off
# 기록 폴더는 서비스 파일에 /var/lib/ic26/marketing 으로 정해져 있습니다 (MARKETING_RECORDS_DIR). 여기 적으면 그쪽이 이깁니다.
# 아래 DB_HOST 가 있으면 맞춤 마케팅 기록도 폴더가 아니라 DB(marketing_sessions·coupon_runs 표)에 둡니다 (11/19, init_db 를 먼저).

# ── DB (Cloud DB for PostgreSQL) ──
# DB_HOST 가 비어 있으면 DB 를 쓰지 않습니다 (서버 메모리와 파일. 서버가 2대면 서버마다 따로 보입니다).
# DB_HOST 를 넣을 때는 DB_USER 와 DB_PASSWORD 도 함께 넣습니다. DB_USER 가 비면 두 서비스가 켜지지 않습니다.
# 값을 넣은 뒤 표를 한 번 만들고 서비스를 다시 시작합니다 (deploy/README.md 6-1절).
# DB_HOST: DB 의 사설 도메인 (콘솔의 DB 상세에서 확인)
DB_HOST=
DB_PORT=5432
DB_NAME=ic26app
DB_USER=
DB_PASSWORD=
# DB Failover 직후 약 30초 동안 DB 도메인이 옛 서버(읽기 전용 standby)를 가리킵니다. 그때 연결 풀이 standby 에 붙으면
# 최대 30분 동안 저장이 실패할 수 있어, standby 에는 아예 연결하지 않게 합니다 (11/18 장애 시험에서 확인). 지우지 않습니다.
PGTARGETSESSIONATTRS=read-write
