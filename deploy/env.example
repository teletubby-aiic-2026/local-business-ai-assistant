# ic26 서버 환경 파일 틀  →  서버의 /etc/ic26/env (소유자 root, 권한 600)
#
# install_was.sh 가 /etc/ic26/env 가 없을 때만 이 파일을 복사해 만듭니다. 이미 있으면 건드리지 않습니다.
# 값은 서버에서 편집기로 직접 입력합니다:   sudo vi -n -i NONE /etc/ic26/env
#   - 명령줄 인자(echo, sed, export 등), 셸 히스토리, 메신저, 캡처에 값을 남기지 않습니다.
#   - 이 파일은 저장소에 올라가는 틀입니다. 실제 값을 적어서 저장소에 올리지 않습니다.
#
# 적는 규칙 (systemd 가 읽습니다)
#   - 한 줄에 NAME=값 하나. 값에 따옴표와 앞뒤 공백을 넣지 않습니다.
#   - 주석(#)은 줄 맨 앞에서만 씁니다. 값 뒤에 주석을 붙이면 주석까지 값이 됩니다.
#   - 값을 바꾼 뒤에는 서비스를 다시 시작합니다:   sudo systemctl restart ic26-review ic26-was

# ── 실행 모드 ──
# live: HCX-005 실시간 호출(키 필요, 호출마다 비용). mock: 키 없이 도는 시험용 실행(저장된 예시, 실제 AI 결과 아님)
APP_MODE=live

# ── HCX(CLOVA Studio) 키 ──
# 같은 서버 전용 키를 아래 세 줄에 똑같이 넣습니다. 코드마다 읽는 이름이 달라서 세 줄이 모두 필요합니다.
# 키 값만 넣고 앞에 'Bearer ' 를 붙이지 않습니다. 개발용 키를 쓰지 않습니다.
# 비서 화면 서버(ic26-was)가 읽는 이름
CLOVA_API_KEY=
# 리뷰 분석(ic26-review)이 읽는 이름
CLOVASTUDIO_API_KEY=
# 상권 챗봇(ic26-market)이 읽는 이름. 가운데 밑줄이 하나 더 있습니다 (CLOVA_STUDIO)
CLOVA_STUDIO_API_KEY=

# ── 상권 챗봇 (월요일부터. ic26-market 이 켜져 있을 때만 쓰임) ──
# 1 이면 챗봇을 켭니다. 비우거나 0 이면 챗봇이 없습니다.
ASSISTANT_ENABLED=1
# 하루에 HCX 를 부를 수 있는 최대 횟수 (서버 한 대 기준)
ASSISTANT_MODEL_DAILY_LIMIT=2000

# ── DB (Cloud DB for PostgreSQL) ──
# 지금 코드는 DB를 읽지 않습니다. 이름은 DB를 쓰는 코드가 들어올 때 맞춥니다 (docs/infra/architecture.md 5절).
# DB_HOST: DB 의 사설 도메인 (콘솔의 DB 상세에서 확인)
DB_HOST=
DB_PORT=5432
DB_NAME=ic26app
DB_USER=
DB_PASSWORD=
