# 비밀 값 받아 오기 (Secret Manager → /run/ic26/secrets.env). 서버가 켜질 때 한 번 돌고 끝난다.
# 설치: deploy/install_was.sh 가 /etc/systemd/system/ 으로 복사하고 enable 합니다.
#
# /etc/ic26/env 의 IC26_SM_ID 가 비어 있으면 아무것도 하지 않습니다 (env 의 값을 그대로 씀).
# ic26 서비스 4개는 이 서비스가 끝난 뒤에 시작하고(After), /run/ic26/secrets.env 를 env 다음에 읽습니다.
# 이 서비스가 실패해도 서비스 4개는 env 의 값으로 켜집니다 (Requires 가 아니라 Wants).
#
# 값을 바꾼 뒤(Secret Manager 콘솔에서):
#   sudo systemctl restart ic26-secrets && sudo systemctl restart ic26-review ic26-marketing ic26-was ic26-market
# 결과 보기 (이름만 나옴): journalctl -u ic26-secrets -n 20
[Unit]
Description=ic26 secrets from Secret Manager (/run/ic26/secrets.env)
After=network-online.target
Wants=network-online.target
Before=ic26-review.service ic26-marketing.service ic26-was.service ic26-market.service

[Service]
Type=oneshot
RemainAfterExit=yes
# 시스템 python3 로 돈다 (표준 라이브러리만 씀. venv 가 깨져도 받아 올 수 있게)
ExecStart=/usr/bin/python3 /opt/ic26/deploy/fetch_secrets.py
# 네트워크가 늦게 열리면 6초 간격으로 20번까지 다시 시도 (약 2분)
TimeoutStartSec=200

[Install]
WantedBy=multi-user.target
