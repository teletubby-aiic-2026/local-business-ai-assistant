  "cases": [
    {"id": "b01", "text": "안녕하세요~ 처음 써보는데 뭐부터 물어보면 돼요?", "expect": {"domain": "general", "turn_type": "smalltalk", "topics": [], "location_mentions": [], "industries": [], "period": {"relative": null, "comparison": null, "period_code": null}, "signals": {"correction": false, "comparison": false}, "business_status": null, "needs_model": false}},
    {"id": "b02", "text": "홍대 쪽 카페 매출 요즘 어때요?", "expect": {"domain": "market_analysis", "turn_type": "data_question", "topics": ["sales_total"], "location_mentions": ["홍대"], "industries": ["CS100010"], "period": {"relative": "latest", "comparison": null, "period_code": null}, "signals": {"correction": false, "comparison": false}, "business_status": null, "needs_model": false}},
    {"id": "b03", "text": "주말은?", "context": {"previous_topics": ["sales_total"]}, "note": "앞 턴의 매출 질문을 주말 매출로 좁히는 말로 보고 sales_weekday만 적음", "expect": {"domain": "market_analysis", "turn_type": "followup", "topics": ["sales_weekday"], "location_mentions": [], "industries": [], "period": {"relative": null, "comparison": null, "period_code": null}, "signals": {"correction": false, "comparison": false}, "business_status": null, "needs_model": false}},
    {"id": "b04", "text": "서교동 분식집 매출 20대가 젤 많이 쓰나", "expect": {"domain": "market_analysis", "turn_type": "data_question", "topics": ["sales_age"], "location_mentions": ["서교동"], "industries": ["CS100008"], "period": {"relative": null, "comparison": null, "period_code": null}, "signals": {"correction": false, "comparison": false}, "business_status": null, "needs_model": false}},
    {"id": "b05", "text": "저희 가게 동네 빵집인데 인스타 홍보 어떻게 하는게 젤 효과 좋아요?", "expect": {"domain": "marketing", "turn_type": "advice", "topics": [], "location_mentions": [], "industries": ["CS100005"], "period": {"relative": null, "comparison": null, "period_code": null}, "signals": {"correction": false, "comparison": false}, "business_status": "operating", "needs_model": false}},
