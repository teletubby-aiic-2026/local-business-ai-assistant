# Copy to .env in this directory. Never commit real values.
# Required only for explicit official-data collection:
SEOUL_OPENAPI_KEY=
# Required for NAVER map rendering and address geocoding:
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# Leave empty for localhost. Set one HTTPS origin when using a reverse proxy.
APP_PUBLIC_ORIGIN=
# Optional: set ONBOARDING_DB_PATH to an absolute path.
# When unset, the database is data/onboarding.sqlite3 in this module.
