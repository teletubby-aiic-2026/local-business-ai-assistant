# Copy to .env in this directory. Never commit real values.
# Required only for explicit official-data collection:
SEOUL_OPENAPI_KEY=
# Required for NAVER map rendering and address geocoding:
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
# Leave empty for localhost. Set one HTTPS origin when using a reverse proxy.
APP_PUBLIC_ORIGIN=
# Optional: set to 1 or true to mount the assistant routes (/api/assistant/...).
# Leave empty to run only the B1~B6 analysis app.
ASSISTANT_ENABLED=
# Assistant model mode: empty or mock = fixed-form answers, no model call.
# live = CLOVA Studio writes the answer text with your own CLOVA Studio key.
APP_MODE=
CLOVA_STUDIO_API_KEY=
# Optional: answer model (default HCX-005) and model calls per day (default 100).
# With the planner on, a data answer uses two calls (decide + write).
CLOVA_MODEL_ANSWER=
ASSISTANT_MODEL_DAILY_LIMIT=
# Optional with APP_MODE=live: the AI planner decides each turn (default on). off = rule classifier only.
ASSISTANT_PLANNER=
# Optional: set ONBOARDING_DB_PATH to an absolute path.
# When unset, the database is data/onboarding.sqlite3 in this module.
