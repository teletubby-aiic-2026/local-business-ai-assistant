# 실행 모드: mock(규칙만, 키 불필요) | live(HCX-005 호출, 결과를 data/replay 에 저장) | replay(저장본 재생, 발표용)
APP_MODE=mock
# CLOVA Studio. 키는 .env 에만 적고 저장소에 올리지 않습니다
CLOVASTUDIO_API_KEY=
# (상권 비서와 같은 이름 CLOVA_STUDIO_API_KEY 도 읽음)
# 리뷰 분류 모델 (기본 HCX-005)
LLM_MODEL_REVIEW=HCX-005
# 호출 한 번 시간 제한 (초)
LLM_TIMEOUT_SECONDS=20
# 밖(서버)에 띄울 때만: 정하면 X-Access-Token 헤더에 같은 값을 보낸 요청만 받음. 팀원에게 따로 알려 주기
APP_ACCESS_TOKEN=
